<view class="page-settings">
  <!-- 个人信息 -->
  <view class="card">
    <view class="setting-item" bindtap="onChangeNickname">
      <text class="setting-name">昵称</text>
      <text class="setting-value">{{nickname}}</text>
      <text class="setting-arrow">▶</text>
    </view>
    <view class="setting-item" bindtap="onSelectTitle">
      <text class="setting-name">称号</text>
      <text class="setting-value" style="color: #f59e0b;">{{title}}</text>
      <text class="setting-arrow">▶</text>
    </view>
    <view class="setting-item">
      <text class="setting-name">问候语显示称号</text>
      <switch checked="{{greetingMode === 'title'}}" bindchange="onToggleGreeting" color="#f59e0b"/>
    </view>
  </view>

  <!-- 功能开关 -->
  <view class="card">
    <view class="setting-item">
      <text class="setting-name">语音播报</text>
      <switch checked="{{voiceEnabled}}" bindchange="onToggleVoice" color="#f59e0b"/>
    </view>
    <view class="setting-item">
      <text class="setting-name">消息通知</text>
      <switch checked="{{notificationEnabled}}" bindchange="onToggleNotification" color="#f59e0b"/>
    </view>
  </view>

  <!-- 其他 -->
  <view class="card">
    <view class="setting-item" bindtap="onClearCache">
      <text class="setting-name">清除缓存</text>
      <text class="setting-arrow">▶</text>
    </view>
    <view class="setting-item" bindtap="onAbout">
      <text class="setting-name">关于</text>
      <text class="setting-arrow">▶</text>
    </view>
  </view>
</view>
