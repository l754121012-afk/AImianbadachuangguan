<view class="page">
  <view class="hero">
    <view class="hero-title">选择适合你的套餐</view>
    <view class="hero-desc">全部场景开放，按需升级AI增值服务</view>
  </view>

  <view class="tier-grid">
    <view class="tier-card {{item.recommended ? 'recommended' : ''}}" wx:for="{{tiers}}" wx:key="id">
      <view class="tier-badge {{item.badgeClass}}">{{item.badge}}</view>
      <view class="tier-name">{{item.name}}</view>
      <view class="tier-price">
        <text class="tier-currency">¥</text>{{item.price}}<text class="tier-unit">/{{item.unit}}</text>
      </view>
      <view class="tier-desc">{{item.desc}}</view>
      <view class="tier-rows">
        <view class="tier-row" wx:for="{{item.summaryRows}}" wx:key="label">
          <text class="tier-check {{item.check ? 'yes' : 'no'}}">{{item.check ? '✓' : '✗'}}</text>
          <text class="tier-label">{{item.label}}</text>
        </view>
      </view>
      <view class="tier-highlight" wx:if="{{item.highlight}}">{{item.highlight}}</view>
      <view class="tier-btn" data-index="{{index}}" bindtap="onBuy">立即购买</view>
    </view>
  </view>

  <view class="principles">
    <view class="pr-item">
      <text class="pr-icon">🎯</text>
      <text class="pr-text">场景全开放：求职/考研/考公全部免费</text>
    </view>
    <view class="pr-item">
      <text class="pr-icon">🧠</text>
      <text class="pr-text">AI增值分层：Pro聚焦高级分析服务</text>
    </view>
    <view class="pr-item">
      <text class="pr-icon">📈</text>
      <text class="pr-text">体验驱动付费：免费可看完整基础功能</text>
    </view>
  </view>

  <view class="compare-entry" bindtap="onCompare">
    <text class="compare-text">📊 查看不同套餐在各页面的效果对比</text>
    <text class="compare-arrow">›</text>
  </view>

  <view class="safe-note">安全支付 · 即时生效 · 支持随时取消</view>

  <payment-modal show="{{showPayment}}" bind:close="onClosePayment" />
</view>
