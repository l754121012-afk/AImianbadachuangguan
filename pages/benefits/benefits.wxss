.page {
  min-height: 100vh;
  background: #0a0e1a;
  padding: 0 24rpx 60rpx;
}

.hero {
  text-align: center;
  padding: 48rpx 0 32rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 12rpx;
}
.hero-desc {
  font-size: 26rpx;
  color: #6b7280;
}

/* Tier Grid - 2x2 full width */
.tier-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tier-card {
  width: calc(50% - 8rpx);
  background: #111827;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  border: 1px solid rgba(255,255,255,0.06);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.tier-card.recommended {
  border-color: #f59e0b;
  box-shadow: 0 0 24rpx rgba(245,158,11,0.12);
}
.tier-badge {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-bottom: 10rpx;
  align-self: flex-start;
}
.badge-gray { background: rgba(107,114,128,0.15); color: #9ca3af; }
.badge-gold { background: rgba(245,158,11,0.15); color: #f59e0b; }

.tier-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}
.tier-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #fbbf24;
  margin-bottom: 4rpx;
}
.tier-currency { font-size: 24rpx; }
.tier-unit { font-size: 20rpx; color: #6b7280; font-weight: 400; }
.tier-desc {
  font-size: 20rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.tier-rows {
  flex: 1;
  margin-bottom: 10rpx;
}
.tier-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 5rpx 0;
}
.tier-check { width: 24rpx; font-size: 20rpx; flex-shrink: 0; }
.tier-check.yes { color: #10b981; }
.tier-check.no { color: #374151; }
.tier-label { font-size: 20rpx; color: #9ca3af; flex: 1; }
.tier-highlight {
  margin-bottom: 10rpx;
  padding: 8rpx 10rpx;
  background: rgba(245,158,11,0.1);
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #fbbf24;
  text-align: center;
}
.tier-btn {
  width: 100%;
  padding: 18rpx 0;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  font-weight: 700;
  font-size: 26rpx;
  text-align: center;
  border-radius: 16rpx;
  margin-top: auto;
}

/* Principles */
.principles {
  background: #111827;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 32rpx 0 24rpx;
  border: 1px solid rgba(255,255,255,0.06);
}
.pr-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.pr-item:last-child { margin-bottom: 0; }
.pr-icon { font-size: 28rpx; flex-shrink: 0; margin-top: 2rpx; }
.pr-text { font-size: 26rpx; color: #9ca3af; line-height: 1.5; }

/* Compare Entry */
.compare-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #111827;
  border-radius: 20rpx;
  border: 1px solid rgba(139,92,246,0.2);
  margin-bottom: 24rpx;
}
.compare-text {
  font-size: 28rpx;
  color: #a78bfa;
  font-weight: 600;
}
.compare-arrow {
  font-size: 32rpx;
  color: #a78bfa;
  font-weight: 700;
}

.safe-note {
  text-align: center;
  font-size: 22rpx;
  color: #4b5563;
  padding: 16rpx 0;
}
