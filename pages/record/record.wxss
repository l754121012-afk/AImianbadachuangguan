.page-record {
  padding: 0 32rpx 40rpx;
  min-height: 100vh;
  background: #0a0e1a;
}

/* 个人信息 */
.profile-header {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 40rpx 0 32rpx;
  position: relative;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-emoji {
  font-size: 60rpx;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.profile-title {
  font-size: 26rpx;
  color: #f59e0b;
  font-weight: 600;
  margin-top: 4rpx;
}

.profile-meta {
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.vip-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 20rpx;
  background: rgba(245,158,11,0.15);
  color: #f59e0b;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

.vip-badge.vip-active {
  background: rgba(139,92,246,0.15);
  color: #a78bfa;
}

.profile-arrow {
  margin-left: auto;
  color: #4b5563;
  font-size: 24rpx;
}

/* 统计 */
.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  flex: 1;
  background: #111827;
  border-radius: 28rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.stat-num.gold { color: #f59e0b; }
.stat-num.blue { color: #3b82f6; }
.stat-num.green { color: #10b981; }

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

/* 通用卡片 */
.card {
  background: #111827;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 24rpx;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-filter {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

/* 能力分析 */
.ability-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.ability-item:last-child { margin-bottom: 0; }

.ability-name {
  width: 80rpx;
  font-size: 28rpx;
  color: #9ca3af;
  text-align: right;
  flex-shrink: 0;
}

.ability-bar-bg {
  flex: 1;
  height: 16rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 999rpx;
  overflow: hidden;
}

.ability-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}

.ability-score {
  width: 56rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  text-align: right;
  flex-shrink: 0;
}

/* 历史列表 */
.history-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(255,255,255,0.04);
}

.history-item:last-child { border-bottom: none; }

.history-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.history-icon-wrap.job { background: rgba(245,158,11,0.12); }
.history-icon-wrap.kaoyan { background: rgba(59,130,246,0.12); }
.history-icon-wrap.kaogong { background: rgba(16,185,129,0.12); }

.history-info {
  flex: 1;
  min-width: 0;
}

.history-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.history-meta {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.history-score {
  font-size: 40rpx;
  font-weight: 800;
  color: #f59e0b;
  flex-shrink: 0;
}

.history-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

/* 菜单 */
.menu-card {
  padding: 16rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
}

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.menu-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.menu-arrow {
  color: #4b5563;
  font-size: 26rpx;
}
