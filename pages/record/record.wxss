.page-record {
  padding: 0 32rpx 40rpx;
  min-height: 100vh;
  background: #0a0e1a;
}

/* 个人信息 */
.profile-header {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 40rpx 0 32rpx;
  position: relative;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-emoji {
  font-size: 60rpx;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.profile-title {
  display: inline-block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}
.title-gray { background: rgba(107,114,128,0.15); color: #9ca3af; }
.title-blue { background: rgba(59,130,246,0.12); color: #60a5fa; border: 1rpx solid rgba(59,130,246,0.25); }
.title-gold { background: linear-gradient(135deg, rgba(139,92,246,0.25), rgba(59,130,246,0.15)); color: #e9d5ff; border: 1.5rpx solid rgba(139,92,246,0.5); box-shadow: 0 0 24rpx rgba(139,92,246,0.25), 0 0 48rpx rgba(139,92,246,0.08); font-size: 24rpx; padding: 8rpx 24rpx; }
.title-pro { background: linear-gradient(135deg, #f59e0b, #ffd700, #ffb300, #ffe082, #f59e0b); background-size: 300% 300%; color: #1a1a00; border: 2rpx solid #ffd700; box-shadow: 0 0 24rpx rgba(245,158,11,0.4), 0 0 64rpx rgba(255,215,0,0.2); font-size: 24rpx; padding: 8rpx 24rpx; font-weight: 800; animation: borderRotate 3s linear infinite; }

.profile-meta {
  position: absolute;
  top: 40rpx;
  right: 0;
  font-size: 24rpx;
  color: #9ca3af;
}

.vip-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
  opacity: 0.85;
}

.vip-badge-gray { background: rgba(107,114,128,0.15); color: #9ca3af; }
.vip-badge-blue { background: rgba(59,130,246,0.12); color: #60a5fa; border: 1rpx solid rgba(59,130,246,0.25); }
.vip-badge-gold { background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(139,92,246,0.1)); color: #c4b5fd; border: 1rpx solid rgba(139,92,246,0.4); box-shadow: 0 0 16rpx rgba(139,92,246,0.15); }
.vip-badge-pro { background: linear-gradient(135deg, #f59e0b, #ffd700, #ffb300, #ffe082, #f59e0b); background-size: 300% 300%; color: #1a1a00; border: 2rpx solid #ffd700; box-shadow: 0 0 20rpx rgba(245,158,11,0.4), 0 0 56rpx rgba(255,215,0,0.2); font-weight: 800; animation: borderRotate 3s linear infinite; }

.vip-badge.vip-active {
  background: rgba(139,92,246,0.15);
  color: #a78bfa;
}

.profile-arrow {
  margin-left: auto;
  color: #4b5563;
  font-size: 24rpx;
}

.section-divider {
  height: 2rpx;
  background: rgba(255,255,255,0.06);
  margin: 32rpx 0 32rpx;
}

/* 统计 */
.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  flex: 1;
  background: #111827;
  border-radius: 28rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.stat-num.gold { color: #f59e0b; }
.stat-num.blue { color: #3b82f6; }
.stat-num.green { color: #10b981; }

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

/* 通用卡片 */
.card {
  background: #111827;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 24rpx;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-filter {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

/* 能力分析 */
.ability-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.ability-item:last-child { margin-bottom: 0; }

.ability-name {
  width: 80rpx;
  font-size: 28rpx;
  color: #9ca3af;
  text-align: right;
  flex-shrink: 0;
}

.ability-bar-bg {
  flex: 1;
  height: 16rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 999rpx;
  overflow: hidden;
}

.ability-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}

.ability-score {
  width: 56rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  text-align: right;
  flex-shrink: 0;
}

/* 历史列表 */
.history-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(255,255,255,0.04);
}

.history-item:last-child { border-bottom: none; }

.history-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.history-icon-wrap.job { background: rgba(245,158,11,0.12); }
.history-icon-wrap.kaoyan { background: rgba(59,130,246,0.12); }
.history-icon-wrap.kaogong { background: rgba(16,185,129,0.12); }

.history-info {
  flex: 1;
  min-width: 0;
}

.history-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.history-meta {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.history-score {
  font-size: 40rpx;
  font-weight: 800;
  color: #f59e0b;
  flex-shrink: 0;
}

.history-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

/* 菜单 */
.menu-card {
  padding: 16rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
}

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.menu-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.menu-arrow {
  color: #4b5563;
  font-size: 26rpx;
}

.upgrade-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
}
.upgrade-bar.vip-badge-gray { background: rgba(107,114,128,0.15); }
.upgrade-bar.vip-badge-blue { background: rgba(59,130,246,0.12); border: 1rpx solid rgba(59,130,246,0.25); }
.upgrade-bar.vip-badge-gold { background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(139,92,246,0.1)); border: 1rpx solid rgba(139,92,246,0.4); box-shadow: 0 0 16rpx rgba(139,92,246,0.15); }
.upgrade-bar.vip-badge-pro { background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(255,200,50,0.1)); border: 1.5rpx solid rgba(245,158,11,0.5); box-shadow: 0 0 20rpx rgba(245,158,11,0.3); }
.upgrade-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}
.upgrade-bar.vip-badge-gray .upgrade-text { color: #9ca3af; }
.upgrade-bar.vip-badge-blue .upgrade-text { color: #60a5fa; }
.upgrade-bar.vip-badge-gold .upgrade-text { color: #c4b5fd; }
.upgrade-bar.vip-badge-pro .upgrade-text { color: #ffe082; }
.upgrade-arrow {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
.upgrade-bar.vip-badge-gray .upgrade-arrow { color: #9ca3af; }
.upgrade-bar.vip-badge-blue .upgrade-arrow { color: #60a5fa; }
.upgrade-bar.vip-badge-gold .upgrade-arrow { color: #c4b5fd; }
.upgrade-bar.vip-badge-pro .upgrade-arrow { color: #ffe082; }
@keyframes borderRotate { 0% { background-position: 0% 0%; } 25% { background-position: 100% 0%; } 50% { background-position: 100% 100%; } 75% { background-position: 0% 100%; } 100% { background-position: 0% 0%; } }
