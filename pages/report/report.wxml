<view class="page-report">
  <!-- 分数区 -->
  <view class="report-hero">
    <view class="grade-circle" style="background: {{gradeInfo.bg}}; border-color: {{gradeInfo.border}};">
      <view class="grade-letter" style="color: {{gradeInfo.text}};">{{gradeInfo.grade}}</view>
      <view class="grade-desc-text" style="color: {{gradeInfo.text}};">{{gradeInfo.desc}}</view>
    </view>
    <view class="score-secondary">
      <text class="score-num">{{score}}</text>
      <text class="score-unit">分</text>
    </view>
    <view class="score-subtitle">{{interviewTitle}} · 超过{{percentile}}%的用户</view>
  </view>

  <!-- 五维能力分析 -->
  <view class="section-header">
    <view class="section-title">五维能力分析</view>
    <view class="section-badge" wx:if="{{!isUnlocked}}">🔒 预览</view>
    <view class="section-badge" wx:if="{{isUnlocked && !isPro}}" style="color:#10b981;background:rgba(16,185,129,0.1)">✓ 已解锁</view>
    <view class="section-badge" wx:if="{{isPro}}" style="color:#8b5cf6;background:rgba(139,92,246,0.1)">Pro</view>
  </view>

  <!-- 免费用户：预览模式 -->
  <view wx:if="{{!isUnlocked}}" class="preview-wrap">
    <view class="dimension-list preview-blur">
      <view class="dim-item" wx:for="{{previewDimensions}}" wx:key="name">
        <view class="dim-label">{{item.name}}</view>
        <view class="dim-track"><view class="dim-fill dim-fill-dim" style="width: {{item.score}}%"></view></view>
        <view class="dim-value">{{item.score}}</view>
      </view>
    </view>
    <view class="preview-cover" bindtap="onUnlock">
      <view class="preview-icon">🔒</view>
      <view class="preview-text">解锁查看完整五维分析</view>
      <view class="preview-sub">升级任意套餐，解锁全部能力评估</view>
    </view>
  </view>

  <!-- VIP用户：完整五维分析 -->
  <view wx:if="{{isUnlocked}}" class="dimension-list">
    <view class="dim-item" wx:for="{{dimensions}}" wx:key="name">
      <view class="dim-label">{{item.name}}</view>
      <view class="dim-track"><view class="dim-fill" style="width: {{item.score}}%"></view></view>
      <view class="dim-value">{{item.score}}</view>
    </view>
  </view>

  <!-- Pro专属：AI深度分析 -->
  <view wx:if="{{isPro}}" class="pro-block">
    <view class="pro-block-header">
      <text class="pro-block-title">🧠 AI深度分析</text>
      <text class="pro-block-badge">Pro</text>
    </view>
    <view class="pro-block-text">{{aiAnalysis}}</view>
  </view>

  <!-- Pro专属：个性化提升建议 -->
  <view wx:if="{{isPro}}" class="pro-block pro-block-violet">
    <view class="pro-block-header">
      <text class="pro-block-title">📋 个性化提升建议</text>
      <text class="pro-block-badge">Pro</text>
    </view>
    <view class="pro-suggestion" wx:for="{{suggestions}}" wx:key="*this">
      <text class="pro-sug-num">{{index + 1}}</text>
      <text class="pro-sug-text">{{item}}</text>
    </view>
  </view>

  <!-- Pro专属：语音语调分析 -->
  <view wx:if="{{isPro}}" class="pro-block pro-block-green">
    <view class="pro-block-header">
      <text class="pro-block-title">🎤 语音语调分析</text>
      <text class="pro-block-badge">Pro</text>
    </view>
    <view class="voice-grid">
      <view class="voice-item">
        <text class="voice-icon">⚡</text>
        <text class="voice-value">{{voiceData.speed}}</text>
        <text class="voice-label">语速(字/分)</text>
      </view>
      <view class="voice-item">
        <text class="voice-icon">⏸️</text>
        <text class="voice-value">{{voiceData.pause}}</text>
        <text class="voice-label">平均停顿</text>
      </view>
      <view class="voice-item">
        <text class="voice-icon">😊</text>
        <text class="voice-value">{{voiceData.confidence}}%</text>
        <text class="voice-label">自信度</text>
      </view>
      <view class="voice-item">
        <text class="voice-icon">🎯</text>
        <text class="voice-value">{{voiceData.fluency}}%</text>
        <text class="voice-label">流畅度</text>
      </view>
    </view>
  </view>

  <!-- Pro专属：历史趋势对比 -->
  <view wx:if="{{isPro}}" class="pro-block">
    <view class="pro-block-header">
      <text class="pro-block-title">📈 历史趋势对比</text>
      <text class="pro-block-badge">Pro</text>
    </view>
    <view class="trend-bars">
      <view class="trend-col" wx:for="{{trendData}}" wx:key="date">
        <text class="trend-score">{{item.score}}</text>
        <view class="trend-bar" style="height: {{item.score * 0.7}}px"></view>
        <text class="trend-date">{{item.date}}</text>
      </view>
    </view>
    <view class="trend-summary">
      <text wx:if="{{trendData.length >= 2}}">📊 近一个月提升 <text class="trend-up">+{{trendData[trendData.length - 1].score - trendData[0].score}}分</text></text>
    </view>
  </view>

  <!-- Pro锁定的预览提示 -->
  <view wx:if="{{isUnlocked && !isPro}}" class="pro-locked-area">
    <view class="pro-locked-item">
      <text class="pro-lock-icon">🔒</text>
      <text class="pro-lock-title">AI深度分析 · Pro年卡专属</text>
      <text class="pro-lock-desc">升级Pro获取个性化提升建议</text>
    </view>
    <view class="pro-locked-item">
      <text class="pro-lock-icon">📈</text>
      <text class="pro-lock-title">历史趋势对比 · Pro年卡专属</text>
      <text class="pro-lock-desc">查看多次练习的进步曲线</text>
    </view>
    <view class="pro-locked-item">
      <text class="pro-lock-icon">🎤</text>
      <text class="pro-lock-title">语音语调分析 · Pro年卡专属</text>
      <text class="pro-lock-desc">语速、停顿、情感等深度分析</text>
    </view>
  </view>

  <!-- 逐题分析 -->
  <view class="section-header">
    <view class="section-title">逐题分析</view>
    <view class="section-badge" wx:if="{{!isUnlocked}}">预览前{{previewCount}}题</view>
    <view class="section-badge" wx:if="{{isUnlocked}}" style="color:#10b981;background:rgba(16,185,129,0.1)">全部{{questions.length}}题</view>
  </view>

  <view class="q-card" wx:for="{{questions}}" wx:key="id" wx:if="{{item.show || isUnlocked}}">
    <view class="q-card-inner">
      <view class="q-top-row">
        <view class="q-num">Q{{item.id}} · {{item.title}}</view>
        <view class="q-actions">
          <view class="q-fav {{item.favorited ? 'faved' : ''}}" catchtap="onToggleFav" data-id="{{item.id}}">
            {{item.favorited ? '★' : '☆'}} 收藏
          </view>
          <view class="q-badge badge-{{item.badgeKey}}">{{item.badge}}</view>
        </view>
      </view>
      <view class="q-title">{{item.text}}</view>
      <view class="q-answer" wx:if="{{item.userAnswer}}">
        <view class="q-answer-label">你的回答：</view>
        <view class="q-answer-text">{{item.userAnswer}}</view>
      </view>
      <view class="q-feedback">{{item.feedback}}</view>
      <view class="q-score-row">得分：<text class="q-score-num">{{item.score}}</text> 分</view>
    </view>
  </view>

  <!-- 锁定题目 -->
  <view wx:if="{{!isUnlocked && lockedCount > 0}}" class="q-card locked-card" bindtap="onUnlock">
    <view class="q-card-inner">
      <view class="lock-icon">🔒</view>
      <view class="lock-title">还有 {{lockedCount}} 题详细分析已锁定</view>
      <view class="lock-desc">升级会员查看完整逐题反馈、评分、改进建议</view>
      <view class="lock-btn">立即解锁 →</view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="btn-row">
    <view class="btn-primary" wx:if="{{!isUnlocked}}" bindtap="onUnlock">🔓 解锁完整报告</view>
    <view class="btn-primary" wx:if="{{isUnlocked && !isPro}}" bindtap="onUnlock" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed)">🚀 升级Pro年卡</view>
    <view class="btn-outline" bindtap="onShare">📷 分享成绩</view>
    <view class="btn-outline" bindtap="onRetry">🔄 再练一次</view>
  </view>

  <payment-modal show="{{showPayment}}" bind:close="onClosePayment" />
</view>