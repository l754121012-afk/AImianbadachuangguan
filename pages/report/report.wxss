.page-report {
  padding: 0 32rpx 40rpx;
  min-height: 100vh;
  background: #0a0e1a;
}

.report-hero {
  text-align: center;
  padding: 56rpx 32rpx 40rpx;
}
.grade-circle {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  border: 6rpx solid;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 60rpx rgba(245,158,11,0.15);
}
.grade-letter {
  font-size: 96rpx;
  font-weight: 900;
  line-height: 1;
}
.grade-desc-text {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 8rpx;
  opacity: 0.9;
}
.score-secondary { margin-bottom: 8rpx; }
.score-num { font-size: 44rpx; font-weight: 700; color: #9ca3af; }
.score-unit { font-size: 24rpx; color: #6b7280; margin-left: 4rpx; }
.score-subtitle { font-size: 26rpx; color: #6b7280; }

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}
.section-badge {
  font-size: 22rpx;
  color: #f59e0b;
  background: rgba(245,158,11,0.1);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

/* 维度条 */
.dimension-list { margin-bottom: 32rpx; }
.dim-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.dim-label {
  width: 144rpx;
  font-size: 26rpx;
  color: #9ca3af;
  text-align: right;
  flex-shrink: 0;
}
.dim-track {
  flex: 1;
  height: 16rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 8rpx;
  overflow: hidden;
}
.dim-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f59e0b, #fbbf24);
  transition: width 0.8s;
}
.dim-fill-dim {
  background: linear-gradient(90deg, #6b7280, #9ca3af);
}
.dim-value {
  width: 56rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #f59e0b;
  flex-shrink: 0;
  text-align: right;
}

/* 预览覆盖 */
.preview-wrap {
  position: relative;
  margin-bottom: 32rpx;
}
.preview-blur {
  filter: blur(4px);
  opacity: 0.4;
  pointer-events: none;
}
.preview-cover {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  background: rgba(10,14,26,0.85);
  padding: 36rpx 48rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(245,158,11,0.3);
  width: 80%;
}
.preview-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.preview-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #f59e0b;
  margin-bottom: 8rpx;
}
.preview-sub {
  font-size: 24rpx;
  color: #6b7280;
}

/* 题目卡片 */
.q-card {
  margin-bottom: 20rpx;
  background: #111827;
  border-radius: 28rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
}
.q-card-inner {
  padding: 28rpx;
}
.q-card-inner.locked {
  opacity: 0.4;
}
.q-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.q-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #6b7280;
}
.q-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.q-fav {
  font-size: 22rpx;
  color: #6b7280;
  padding: 4rpx 12rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 12rpx;
}
.q-fav.faved {
  color: #f59e0b;
  background: rgba(245,158,11,0.1);
}
.q-title {
  font-size: 28rpx;
  color: #e5e7eb;
  margin-bottom: 16rpx;
  line-height: 1.4;
}
.q-answer {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.02);
  border-radius: 16rpx;
  border-left: 4rpx solid #3b82f6;
}
.q-answer-label {
  font-size: 22rpx;
  color: #3b82f6;
  margin-bottom: 8rpx;
}
.q-answer-text {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.5;
}
.q-feedback {
  font-size: 26rpx;
  color: #9ca3af;
  padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 16rpx;
  line-height: 1.5;
}
.q-score-row {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 12rpx;
}
.q-score-num {
  color: #f59e0b;
  font-weight: 700;
}
.q-badge {
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.badge-优秀 { background: rgba(16,185,129,0.15); color: #10b981; }
.badge-良好 { background: rgba(59,130,246,0.15); color: #3b82f6; }
.badge-合格 { background: rgba(245,158,11,0.15); color: #f59e0b; }
.badge-待提升 { background: rgba(239,68,68,0.15); color: #ef4444; }
.badge-需努力 { background: rgba(107,114,128,0.15); color: #6b7280; }

/* 锁定卡片 */
.locked-card {
  border: 2rpx dashed rgba(245,158,11,0.2);
  background: rgba(245,158,11,0.03);
}
.lock-icon {
  font-size: 48rpx;
  text-align: center;
  margin-bottom: 12rpx;
}
.lock-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f59e0b;
  text-align: center;
  margin-bottom: 8rpx;
}
.lock-desc {
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
  margin-bottom: 16rpx;
}
.lock-btn {
  text-align: center;
  font-size: 26rpx;
  color: #f59e0b;
  font-weight: 600;
}

/* 按钮 */
.btn-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
  padding-bottom: 40rpx;
}
.btn-primary {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  font-weight: 700;
  font-size: 30rpx;
  text-align: center;
  border-radius: 24rpx;
}
.btn-outline {
  width: 100%;
  padding: 24rpx;
  background: rgba(255,255,255,0.04);
  color: #9ca3af;
  font-size: 28rpx;
  text-align: center;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
}