<view class="page">
  <view class="tab-bar">
    <view class="tab-item {{selectedTab === index ? 'active' : ''}}"
          wx:for="{{tabs}}" wx:key="*this"
          data-index="{{index}}" bindtap="onTabTap">
      {{item}}
    </view>
  </view>

  <!-- ===== Tab 0: 权益对比总览 ===== -->
  <view class="tab-content" wx:if="{{selectedTab === 0}}">
    <view class="principles">
      <view class="pr-item">
        <text class="pr-icon">🎯</text>
        <text class="pr-text">场景全开放：求职/考研/考公全部免费</text>
      </view>
      <view class="pr-item">
        <text class="pr-icon">🧠</text>
        <text class="pr-text">AI增值分层：Pro聚焦高级分析服务</text>
      </view>
      <view class="pr-item">
        <text class="pr-icon">📈</text>
        <text class="pr-text">体验驱动付费：免费可看完整基础功能</text>
      </view>
    </view>

    <view class="diff-section-title">核心功能差异对比</view>
    <view class="diff-table">
      <view class="diff-header-row">
        <view class="diff-header-label">功能</view>
        <view class="diff-header-tier" wx:for="{{tierNames}}" wx:key="*this">
          <text class="diff-tier-badge {{tierColors[index]}}">{{item}}</text>
        </view>
      </view>
      <view class="diff-row" wx:for="{{diffFeatures}}" wx:key="label">
        <view class="diff-label">{{item.label}}</view>
        <view class="diff-cell {{cell.highlight ? 'hl' : ''}}" wx:for="{{item.values}}" wx:for-item="cell" wx:for-index="vi" wx:key="vi">
          <text class="diff-val">{{cell}}</text>
          <text class="diff-up-arrow" wx:if="{{cell.highlight && vi > 0}}">🆕</text>
        </view>
      </view>
    </view>

    <view class="diff-legend">
      <text class="legend-item"><text class="legend-dot new"></text> 较上一档新增</text>
      <text class="legend-item"><text class="legend-dot pro"></text> Pro年卡专属</text>
    </view>
  </view>

  <!-- ===== Tab 1: 首页效果 ===== -->
  <view class="tab-content" wx:if="{{selectedTab === 1}}">
    <view class="scene-title">
      <text class="scene-icon">🏠</text>
      <text class="scene-name">首页 — 不同套餐的首页展示差异</text>
    </view>
    <view class="cmp-grid">
      <!-- 免费版 -->
      <view class="cmp-card tier-gray">
        <view class="cmp-header"><text class="cmp-tier free">免费版</text></view>
        <view class="cmp-body">
          <view class="mu-avatar-row"><view class="mu-avatar">👤</view><view><text class="mu-greet">下午好</text><text class="mu-name">面试达人</text></view></view>
          <view class="mu-stats"><view class="mu-stat"><text class="mu-val">3</text><text class="mu-lbl">剩余次数</text></view><view class="mu-stat"><text class="mu-val">87</text><text class="mu-lbl">最高分</text></view></view>
          <view class="mu-vip-bar free-vip">💎 免费版</view>
          <view class="mu-scene"><text>💼 求职面试</text><text>→</text></view>
          <view class="mu-scene"><text>📚 考研复试</text><text>→</text></view>
          <view class="mu-scene"><text>🏛️ 考公面试</text><text>→</text></view>
        </view>
      </view>
      <!-- 单次体验包 -->
      <view class="cmp-card tier-gray">
        <view class="cmp-header"><text class="cmp-tier single">单次体验包</text></view>
        <view class="cmp-body">
          <view class="mu-avatar-row"><view class="mu-avatar">👤</view><view><text class="mu-greet">下午好</text><text class="mu-name">面试达人</text></view></view>
          <view class="highlight-box">
            <text class="highlight-label">升级</text>
            <view class="mu-stats"><view class="mu-stat"><text class="mu-val">5</text><text class="mu-lbl">剩余次数</text></view><view class="mu-stat"><text class="mu-val">87</text><text class="mu-lbl">最高分</text></view></view>
            <view class="mu-vip-bar single-vip">💎 单次体验包</view>
          </view>
          <view class="mu-scene"><text>💼 求职面试</text><text>→</text></view>
          <view class="mu-scene"><text>📚 考研复试</text><text>→</text></view>
          <view class="mu-scene"><text>🏛️ 考公面试</text><text>→</text></view>
        </view>
      </view>
      <!-- 求职季冲刺包 -->
      <view class="cmp-card tier-gold">
        <view class="cmp-header"><text class="cmp-tier season">求职季冲刺包</text></view>
        <view class="cmp-body">
          <view class="mu-avatar-row"><view class="mu-avatar">👤</view><view><text class="mu-greet">下午好</text><text class="mu-name">面试达人</text></view></view>
          <view class="highlight-box">
            <text class="highlight-label">升级</text>
            <view class="mu-stats"><view class="mu-stat"><text class="mu-val inf">∞</text><text class="mu-lbl">无限次数</text></view><view class="mu-stat"><text class="mu-val">87</text><text class="mu-lbl">最高分</text></view></view>
            <view class="mu-vip-bar season-vip">👑 求职季冲刺包</view>
            <view class="mu-ad-free"><text>🚫</text> 已去除全部广告</view>
          </view>
          <view class="mu-scene"><text>💼 求职面试</text><text>→</text></view>
          <view class="mu-scene"><text>📚 考研复试</text><text>→</text></view>
          <view class="mu-scene"><text>🏛️ 考公面试</text><text>→</text></view>
        </view>
      </view>
      <!-- Pro年卡 -->
      <view class="cmp-card tier-pro">
        <view class="cmp-header"><text class="cmp-tier pro">Pro年卡</text></view>
        <view class="cmp-body">
          <view class="mu-avatar-row"><view class="mu-avatar">👤</view><view><text class="mu-greet">下午好</text><text class="mu-name">面试达人</text></view></view>
          <view class="mu-stats"><view class="mu-stat"><text class="mu-val inf">∞</text><text class="mu-lbl">无限次数</text></view><view class="mu-stat"><text class="mu-val">87</text><text class="mu-lbl">最高分</text></view></view>
          <view class="mu-vip-bar pro-vip">👑 Pro年卡</view>
          <view class="mu-scene"><text>💼 求职面试</text><text>→</text></view>
          <view class="mu-scene"><text>📚 考研复试</text><text>→</text></view>
          <view class="mu-scene"><text>🏛️ 考公面试</text><text>→</text></view>
          <view class="highlight-box">
            <text class="highlight-label">Pro独享</text>
            <view class="mu-pro-link">🧠 AI教练 · 深度分析</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== Tab 2: 报告效果 ===== -->
