      <!-- 免费版 -->
      <view class="cmp-card tier-gray">
        <view class="cmp-header"><text class="cmp-tier free">免费版</text></view>
        <view class="cmp-body">
          <view class="rp-grade"><view class="rp-circle"><text class="rp-letter">B</text></view><view><text class="rp-score">82分</text></view></view>
          <view class="highlight-box">
            <text class="highlight-label">预览</text>
            <view class="rp-sec-title">五维能力 <text class="rp-lock-tag">🔒 预览</text></view>
            <view class="rp-dim-blur"><view class="rp-dim"><view class="rp-dim-bar" style="width:78%"></view></view><view class="rp-dim"><view class="rp-dim-bar" style="width:85%"></view></view><view class="rp-blur-cover">🔒</view></view>
            <view class="rp-q"><text class="rp-q-num">Q1</text>自我介绍... <text class="rp-q-score">85</text></view>
            <view class="rp-q"><text class="rp-q-num">Q2</text>优点是什么？ <text class="rp-q-score">78</text></view>
            <view class="rp-q-locked">🔒 剩余3题已锁定</view>
          </view>
          <view class="rp-missing">AI深度分析 <text class="no-tag">✗</text></view>
          <view class="rp-missing">提升建议 <text class="no-tag">✗</text></view>
          <view class="rp-missing">历史趋势 <text class="no-tag">✗</text></view>
        </view>
      </view>
      <!-- 单次体验包 -->
      <view class="cmp-card tier-gray">
        <view class="cmp-header"><text class="cmp-tier single">单次体验包</text></view>
        <view class="cmp-body">
          <view class="rp-grade"><view class="rp-circle"><text class="rp-letter">B</text></view><view><text class="rp-score">82分</text></view></view>
          <view class="highlight-box">
            <text class="highlight-label">升级</text>
            <view class="rp-sec-title">五维能力 <text class="rp-unlock-tag">✓ 已解锁</text></view>
            <view class="rp-dim"><view class="rp-dim-bar" style="width:78%"></view></view>
            <view class="rp-dim"><view class="rp-dim-bar" style="width:85%"></view></view>
            <view class="rp-dim"><view class="rp-dim-bar" style="width:72%"></view></view>
            <view class="rp-dim"><view class="rp-dim-bar" style="width:68%"></view></view>
            <view class="rp-dim"><view class="rp-dim-bar" style="width:80%"></view></view>
            <view class="rp-q"><text class="rp-q-num">Q1</text>自我介绍... <text class="rp-q-score">85</text></view>
            <view class="rp-q"><text class="rp-q-num">Q2</text>优点是什么？ <text class="rp-q-score">78</text></view>
            <view class="rp-q"><text class="rp-q-num">Q3</text>为什么选我们？ <text class="rp-q-score">72</text></view>
            <view class="rp-q-all">✓ 全部5题已解锁</view>
          </view>
          <view class="rp-missing">AI深度分析 <text class="no-tag">✗</text></view>
          <view class="rp-missing">提升建议 <text class="no-tag">✗</text></view>
        </view>
      </view>
      <!-- 求职季冲刺包 -->
      <view class="cmp-card tier-gold">
        <view class="cmp-header"><text class="cmp-tier season">求职季冲刺包</text></view>
        <view class="cmp-body">
          <view class="rp-grade"><view class="rp-circle"><text class="rp-letter">B</text></view><view><text class="rp-score">82分</text><text class="rp-sub">AI综合点评</text></view></view>
          <view class="rp-sec-title">五维能力 <text class="rp-unlock-tag">✓ 已解锁</text></view>
          <view class="rp-dim"><view class="rp-dim-bar" style="width:78%"></view></view>
          <view class="rp-dim"><view class="rp-dim-bar" style="width:85%"></view></view>
          <view class="rp-dim"><view class="rp-dim-bar" style="width:72%"></view></view>
          <view class="rp-dim"><view class="rp-dim-bar" style="width:68%"></view></view>
          <view class="rp-dim"><view class="rp-dim-bar" style="width:80%"></view></view>
          <view class="highlight-box">
            <text class="highlight-label">升级</text>
            <view class="rp-ai-comment">📝 AI综合点评：整体表现良好，逻辑清晰</view>
          </view>
          <view class="rp-q"><text class="rp-q-num">Q1~5</text>全部题目反馈 <text class="rp-q-score">已解锁</text></view>
          <view class="rp-missing">AI深度分析 <text class="no-tag">✗</text></view>
          <view class="rp-missing">历史趋势 <text class="no-tag">✗</text></view>
        </view>
      </view>
      <!-- Pro年卡 -->
      <view class="cmp-card tier-pro">
        <view class="cmp-header"><text class="cmp-tier pro">Pro年卡</text></view>
        <view class="cmp-body">
          <view class="rp-grade"><view class="rp-circle"><text class="rp-letter">B</text></view><view><text class="rp-score">82分</text><text class="rp-sub">Pro高级分析</text></view></view>
          <view class="rp-sec-title">五维能力 <text class="rp-pro-tag">Pro</text></view>
          <view class="rp-dim"><view class="rp-dim-bar" style="width:78%"></view></view>
          <view class="rp-dim"><view class="rp-dim-bar" style="width:85%"></view></view>
          <view class="rp-dim"><view class="rp-dim-bar" style="width:72%"></view></view>
          <view class="rp-dim"><view class="rp-dim-bar" style="width:68%"></view></view>
          <view class="rp-dim"><view class="rp-dim-bar" style="width:80%"></view></view>
          <view class="highlight-box">
            <text class="highlight-label">Pro独享</text>
            <view class="rp-pro-feature">🧠 AI深度分析</view>
            <view class="rp-pro-feature">📋 个性化提升建议</view>
            <view class="rp-pro-feature">📈 历史趋势对比</view>
            <view class="rp-pro-feature">🎤 语音语调分析</view>
            <view class="rp-pro-feature">📤 报告导出</view>
          </view>
        </view>
      </view>
    </view>
  </view>

