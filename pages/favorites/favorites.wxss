.page-favorites {
  padding: 32rpx;
  min-height: 100vh;
  background: #0a0e1a;
}

.fav-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  background: #111827;
  border-radius: 28rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
  margin-bottom: 20rpx;
}

.fav-info {
  flex: 1;
  min-width: 0;
}

.fav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.fav-question {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.fav-meta {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.fav-answer-link {
  font-size: 24rpx;
  color: #60a5fa;
  padding: 6rpx 0;
  display: inline-block;
}

.fav-remove {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(239,68,68,0.1);
  color: #ef4444;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #6b7280;
}