.page-prepare {
  padding: 16rpx 32rpx 40rpx;
  min-height: 100vh;
  background: #0a0e1a;
}

.scene-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.scene-tag {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.scene-category {
  font-size: 24rpx;
  color: #f59e0b;
  background: rgba(245,158,11,0.1);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.diff-pills {
  display: flex;
  gap: 16rpx;
}

.diff-pill {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  background: #111827;
  border: 2rpx solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  color: #9ca3af;
  font-size: 28rpx;
  font-weight: 600;
}

.diff-pill.active {
  background: rgba(245,158,11,0.12);
  border-color: #f59e0b;
  color: #f59e0b;
}

.mode-cards {
  display: flex;
  gap: 20rpx;
}

.mode-card {
  flex: 1;
  padding: 32rpx;
  background: #111827;
  border: 2rpx solid rgba(255,255,255,0.08);
  border-radius: 28rpx;
  text-align: center;
  position: relative;
}

.mode-card.active {
  border-color: #f59e0b;
  background: rgba(245,158,11,0.06);
}

.mode-badge {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  background: #f59e0b;
  color: #000;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.mode-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.mode-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.mode-sub {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

/* 模拟广告弹窗 */
.ad-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ad-modal {
  width: 600rpx;
  background: #1a1e2e;
  border-radius: 24rpx;
  padding: 40rpx;
  position: relative;
}
.ad-close {
  position: absolute;
  top: 16rpx; right: 20rpx;
  font-size: 36rpx;
  color: #666;
}
.ad-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFD700;
  text-align: center;
  margin-bottom: 30rpx;
}
.ad-content {
  background: #111425;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.ad-product {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}
.ad-product-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.ad-product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}
.ad-product-desc {
  font-size: 24rpx;
  color: #888;
}
.ad-countdown {
  text-align: center;
  font-size: 28rpx;
  color: #4ECDC4;
  margin-top: 20rpx;
  padding: 12rpx 24rpx;
  background: rgba(78,205,196,0.1);
  border-radius: 8rpx;
  display: inline-block;
}
.ad-reward {
  font-size: 24rpx;
  color: #FFD700;
  text-align: center;
}