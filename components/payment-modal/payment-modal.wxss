.payment-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}
.payment-modal {
  width: 100%;
  background: #111827;
  border-radius: 48rpx 48rpx 0 0;
  padding: 48rpx 32rpx 64rpx;
  max-height: 90vh;
  overflow-y: auto;
}
.payment-handle {
  width: 72rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}
.payment-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}
.payment-sub {
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 32rpx;
}
.price-card {
  padding: 24rpx 28rpx;
  background: #0a0e1a;
  border-radius: 24rpx;
  border: 3rpx solid rgba(255,255,255,0.06);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
}
.price-card.selected {
  border-color: #f59e0b;
  background: rgba(245,158,11,0.04);
  box-shadow: 0 0 40rpx rgba(245,158,11,0.08);
}
.popular-tag {
  position: absolute;
  top: -2rpx;
  right: 28rpx;
  background: #f59e0b;
  color: #000;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 0 0 10rpx 10rpx;
}
.p-info {
  flex: 1;
}
.p-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}
.p-desc {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
.p-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
}
.p-price.active {
  color: #f59e0b;
}
.p-small {
  font-size: 22rpx;
  font-weight: 500;
}
.p-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #000;
  font-weight: 700;
}
.price-card.selected .p-check {
  background: #f59e0b;
  border-color: #f59e0b;
}
.benefit-list {
  margin: 24rpx 8rpx;
  padding: 24rpx;
  background: #0a0e1a;
  border-radius: 20rpx;
}
.benefit-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #f59e0b;
  margin-bottom: 16rpx;
}
.benefit-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #e5e7eb;
}
.benefit-check {
  color: #10b981;
  font-weight: 700;
  font-size: 28rpx;
}
.benefit-text {
  flex: 1;
}
.wxpay-btn {
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  font-weight: 700;
  font-size: 32rpx;
  text-align: center;
  border-radius: 28rpx;
}
.wxpay-note {
  text-align: center;
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 16rpx;
}
