<view class="payment-overlay" wx:if="{{show}}" bindtap="onClose">
  <view class="payment-modal" catchtap="stopPropagation">
    <view class="payment-handle"></view>
    <view class="payment-title">🌟 升级求职季套餐</view>
    <view class="payment-sub">一杯奶茶钱，面试无限练</view>

    <view class="price-card {{selectedIndex === index ? 'selected' : ''}}"
          wx:for="{{prices}}" wx:key="id"
          data-index="{{index}}" bindtap="onSelect">
      <view class="popular-tag" wx:if="{{item.popular}}">最受欢迎</view>
      <view class="p-info">
        <view class="p-name">{{item.name}}</view>
        <view class="p-desc">{{item.desc}}</view>
      </view>
      <view class="p-price {{selectedIndex === index ? 'active' : ''}}">
        <text class="small">¥</text>{{item.price}}
      </view>
      <view class="p-check">
        <text wx:if="{{selectedIndex === index}}">✓</text>
      </view>
    </view>

    <view class="feature-list">
      <view class="feature-item" wx:for="{{features}}" wx:key="*this">
        <text class="check">✓</text>
        <text>{{item}}</text>
      </view>
    </view>

    <view class="wxpay-btn" bindtap="onPay">
      ● 微信支付 ¥{{prices[selectedIndex].price}}
    </view>
    <view class="wxpay-note">安全支付 · 即时生效 · 支持随时取消</view>
  </view>
</view>
