.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background: #111827;
  border-radius: 48rpx 48rpx 0 0;
  padding: 40rpx 32rpx 56rpx;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.modal-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}

.modal-icon-wrap.job { background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(245,158,11,0.05)); }
.modal-icon-wrap.kaoyan { background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(59,130,246,0.05)); }
.modal-icon-wrap.kaogong { background: linear-gradient(135deg, rgba(16,185,129,0.2), rgba(16,185,129,0.05)); }

.modal-info {
  flex: 1;
  min-width: 0;
}

.modal-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.modal-desc {
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.modal-close {
  margin-left: auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 36rpx;
  flex-shrink: 0;
}

/* ===== 分类网格 ===== */
.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.category-item {
  background: #0a0e1a;
  border: 2rpx solid rgba(255,255,255,0.06);
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  position: relative;
  transition: all 0.25s ease;
}

.category-item:active {
  transform: scale(0.96);
}

/* 选中状态 */
.category-item.selected {
  border-color: #f59e0b;
  background: rgba(245,158,11,0.08);
  box-shadow: 0 0 20rpx rgba(245,158,11,0.15);
}

.cat-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
  transition: transform 0.2s;
}

.category-item.selected .cat-icon {
  transform: scale(1.15);
}

.cat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  transition: color 0.2s;
}

.category-item.selected .cat-name {
  color: #f59e0b;
}

.cat-count {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

/* 选中勾选标记 */
.cat-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #f59e0b;
  color: #000;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: popIn 0.25s ease;
}

@keyframes popIn {
  0% { transform: scale(0); }
  60% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* ===== 底部按钮 ===== */
.modal-btn {
  width: 100%;
  padding: 28rpx;
  background: rgba(255,255,255,0.06);
  color: #6b7280;
  font-weight: 700;
  font-size: 30rpx;
  text-align: center;
  border-radius: 28rpx;
  transition: all 0.3s;
}

.modal-btn.active {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #000;
}
