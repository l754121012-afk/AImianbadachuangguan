<view class="page-record">
  <!-- 个人信息 -->
  <view class="profile-header" bindtap="onChangeNickname">
    <view class="profile-avatar">👤</view>
    <view class="profile-info">
      <view class="profile-name">{{nickname}}</view>
      <view class="profile-meta">已练习 {{totalCount}} 次 · 平均 {{avgScore}} 分</view>
      <view class="vip-badge {{isVip ? 'vip-active' : ''}}">{{isVip ? 'Pro年卡' : '免费版'}}</view>
    </view>
    <view class="profile-arrow">▶</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-num gold">{{totalCount}}</text>
      <text class="stat-label">总练习次数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num blue">{{avgScore}}</text>
      <text class="stat-label">平均分</text>
    </view>
    <view class="stat-card">
      <text class="stat-num green">{{totalTime}}</text>
      <text class="stat-label">练习时长</text>
    </view>
  </view>

  <!-- 能力分析 -->
  <view class="card ability-card">
    <view class="card-title">能力分析</view>
    <view class="ability-item" wx:for="{{abilities}}" wx:key="name">
      <text class="ability-name">{{item.name}}</text>
      <view class="ability-bar-bg">
        <view class="ability-bar-fill" style="width: {{item.score}}%; background: {{item.color}};"></view>
      </view>
      <text class="ability-score">{{item.score}}</text>
    </view>
  </view>

  <!-- 面试历史 -->
  <view class="card history-card">
    <view class="card-title-row">
      <text class="card-title">面试历史</text>
      <text class="card-filter">全部 ▶</text>
    </view>
    <view class="history-item" wx:for="{{historyList}}" wx:key="id" data-item="{{item}}" bindtap="onTapHistory">
      <view class="history-icon-wrap {{item.color}}">
        <text>{{item.icon}}</text>
      </view>
      <view class="history-info">
        <view class="history-title">{{item.title}}</view>
        <view class="history-meta">{{item.date}} {{item.time}} · {{item.difficulty}} · {{item.mode}}</view>
      </view>
      <view class="history-score">{{item.score}}</view>
    </view>
    <view class="history-empty" wx:if="{{historyList.length === 0}}">
      <text>暂无面试记录</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="onMenuTap" data-menu="favorites">
      <view class="menu-icon-wrap" style="background: rgba(245,158,11,0.12);">⭐</view>
      <text class="menu-name">收藏题目</text>
      <text class="menu-arrow">▶</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-menu="stats">
      <view class="menu-icon-wrap" style="background: rgba(59,130,246,0.12);">📈</view>
      <text class="menu-name">练习统计</text>
      <text class="menu-arrow">▶</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-menu="settings">
      <view class="menu-icon-wrap" style="background: rgba(16,185,129,0.12);">⚙️</view>
      <text class="menu-name">设置</text>
      <text class="menu-arrow">▶</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-menu="upgrade">
      <view class="menu-icon-wrap" style="background: rgba(139,92,246,0.12);">👑</view>
      <text class="menu-name">升级会员</text>
      <text class="menu-arrow">▶</text>
    </view>
  </view>
</view>
