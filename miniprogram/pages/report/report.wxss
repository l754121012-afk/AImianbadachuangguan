.page-report {
  padding: 0 32rpx 40rpx;
  min-height: 100vh;
  background: #0a0e1a;
}

.report-hero {
  text-align: center;
  padding: 48rpx 32rpx 40rpx;
  background: linear-gradient(180deg, rgba(245,158,11,0.06) 0%, transparent 100%);
}

.score-ring {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  border: 12rpx solid rgba(255,255,255,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.score-ring::before {
  content: '';
  position: absolute;
  inset: -12rpx;
  border-radius: 50%;
  border: 12rpx solid transparent;
  border-top-color: #f59e0b;
  border-right-color: #f59e0b;
  transform: rotate(-30deg);
}

.score-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grade-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
  border: 2rpx solid;
}

.score-number {
  font-size: 80rpx;
  font-weight: 800;
  color: #f59e0b;
  line-height: 1;
}

.score-label {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.grade-desc {
  font-size: 28rpx;
  font-weight: 700;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin: 16rpx 0 20rpx;
}

.dimension-list {
  margin-bottom: 32rpx;
}

.dim-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.dim-label {
  width: 144rpx;
  font-size: 26rpx;
  color: #9ca3af;
  text-align: right;
  flex-shrink: 0;
}

.dim-track {
  flex: 1;
  height: 16rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 8rpx;
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f59e0b, #fbbf24);
  transition: width 0.8s;
}

.dim-value {
  width: 56rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #f59e0b;
  flex-shrink: 0;
  text-align: right;
}

.q-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: #111827;
  border-radius: 28rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
}

.q-card.locked {
  opacity: 0.4;
}

.q-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.q-title {
  font-size: 28rpx;
  color: #e5e7eb;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.q-feedback {
  font-size: 26rpx;
  color: #9ca3af;
  padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 16rpx;
  line-height: 1.5;
}

.q-badge {
  display: inline-block;
  margin-top: 12rpx;
}
