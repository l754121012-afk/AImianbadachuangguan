.page-settings {
  padding: 32rpx;
  min-height: 100vh;
  background: #0a0e1a;
}

.card {
  background: #111827;
  border-radius: 28rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid rgba(255,255,255,0.04);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-name {
  flex: 1;
  font-size: 30rpx;
  color: #fff;
}

.setting-value {
  font-size: 28rpx;
  color: #9ca3af;
}

.setting-arrow {
  color: #4b5563;
  font-size: 24rpx;
}
