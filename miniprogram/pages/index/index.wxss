.page-home {
  padding: 0 32rpx 40rpx;
  min-height: 100vh;
  background: #0a0e1a;
}

.hero {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #3b82f6);
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  box-shadow: 0 16rpx 48rpx rgba(245,158,11,0.2);
}

.greeting {
  font-size: 46rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.sub {
  font-size: 26rpx;
  color: #9ca3af;
}

.scene-list {
  margin-top: 16rpx;
}

.scene-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 36rpx 32rpx;
  background: #111827;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
  margin-bottom: 20rpx;
}

.scene-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}

.scene-icon.job {
  background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(245,158,11,0.05));
}

.scene-icon.kaoyan {
  background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(59,130,246,0.05));
}

.scene-icon.kaogong {
  background: linear-gradient(135deg, rgba(16,185,129,0.2), rgba(16,185,129,0.05));
}

.scene-info {
  flex: 1;
}

.scene-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 4rpx;
}

.scene-desc {
  font-size: 24rpx;
  color: #6b7280;
}

.scene-arrow {
  color: #4b5563;
  font-size: 28rpx;
}

.remaining-bar {
  margin: 32rpx 0;
  padding: 20rpx 28rpx;
  background: rgba(245,158,11,0.06);
  border: 2rpx solid rgba(245,158,11,0.15);
  border-radius: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}

.remaining-bar .count {
  color: #f59e0b;
  font-weight: 700;
}

.history-entry {
  padding: 24rpx 28rpx;
  background: #111827;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.history-link {
  font-size: 26rpx;
  color: #f59e0b;
  font-weight: 600;
}
