.page-interview {
  min-height: 100vh;
  background: #0a0e1a;
  display: flex;
  flex-direction: column;
}

.interview-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid rgba(255,255,255,0.06);
}

.interviewer-mini {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.interview-label {
  flex: 1;
}

.interview-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.interview-meta {
  font-size: 22rpx;
  color: #6b7280;
}

.interview-progress {
  font-size: 26rpx;
  color: #f59e0b;
  font-weight: 700;
  background: rgba(245,158,11,0.1);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.progress-track {
  height: 6rpx;
  background: rgba(255,255,255,0.06);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #3b82f6);
  transition: width 0.5s;
}

.chat-area {
  flex: 1;
  padding: 40rpx 32rpx;
  overflow-y: auto;
}

.chat-bubble {
  max-width: 85%;
  padding: 28rpx 32rpx;
  border-radius: 36rpx;
  font-size: 30rpx;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.chat-bubble.ai {
  background: #111827;
  border: 2rpx solid rgba(255,255,255,0.06);
  border-bottom-left-radius: 8rpx;
  color: #e5e7eb;
}

.chat-bubble.user {
  background: rgba(245,158,11,0.12);
  border: 2rpx solid rgba(245,158,11,0.15);
  border-bottom-right-radius: 8rpx;
  color: #e5e7eb;
  margin-left: auto;
}

.bubble-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.record-area {
  padding: 40rpx 32rpx;
  text-align: center;
  border-top: 2rpx solid rgba(255,255,255,0.06);
  background: rgba(17,24,39,0.5);
}

.record-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ef4444, #dc2626);
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 8rpx rgba(239,68,68,0.2), 0 16rpx 48rpx rgba(239,68,68,0.3);
}

.record-btn.recording {
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 8rpx rgba(239,68,68,0.2), 0 16rpx 48rpx rgba(239,68,68,0.3); }
  50% { box-shadow: 0 0 0 16rpx rgba(239,68,68,0.1), 0 16rpx 64rpx rgba(239,68,68,0.4); }
}

.record-icon {
  font-size: 56rpx;
}

.record-timer {
  font-size: 48rpx;
  font-weight: 800;
  color: #f59e0b;
  margin-bottom: 8rpx;
  font-variant-numeric: tabular-nums;
}

.record-status {
  font-size: 26rpx;
  color: #ef4444;
  font-weight: 600;
}

.record-switch {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #6b7280;
}
