.page-prepare {
  padding: 16rpx 32rpx 40rpx;
  min-height: 100vh;
  background: #0a0e1a;
}

.diff-pills {
  display: flex;
  gap: 16rpx;
}

.diff-pill {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  background: #111827;
  border: 2rpx solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  color: #9ca3af;
  font-size: 28rpx;
  font-weight: 600;
}

.diff-pill.active {
  background: rgba(245,158,11,0.12);
  border-color: #f59e0b;
  color: #f59e0b;
}

.mode-cards {
  display: flex;
  gap: 20rpx;
}

.mode-card {
  flex: 1;
  padding: 32rpx;
  background: #111827;
  border: 2rpx solid rgba(255,255,255,0.08);
  border-radius: 28rpx;
  text-align: center;
  position: relative;
}

.mode-card.active {
  border-color: #f59e0b;
  background: rgba(245,158,11,0.06);
}

.mode-badge {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  background: #f59e0b;
  color: #000;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.mode-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.mode-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.mode-sub {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
